# Copiá este archivo como .env y completá los valores.
# Las tres variables son obligatorias: si falta alguna, la app no arranca.

# Puerto HTTP (número entre 1 y 65535)
PORT=

# URI de conexión a MongoDB (debe empezar con mongodb:// o mongodb+srv://)
MONGODB_URI=

# Entorno de ejecución: development | production | test
NODE_ENV=
